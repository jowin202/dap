#!/bin/sh
python3 - "{{ download_url }}" "{{ filename }}" "{{ curl_flags }}" <<'PYEOF'
import sys, os, struct, getpass, subprocess
from urllib.parse import unquote
from cryptography.exceptions import InvalidTag
from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.ciphers.aead import AESGCM

url, filename, curl_flags = sys.argv[1], unquote(sys.argv[2]), sys.argv[3]

pw = getpass.getpass("Kennwort: ").encode()

# Download über curl statt urllib: Python von python.org kennt unter macOS die System-
# Zertifikate nicht (CERTIFICATE_VERIFY_FAILED), curl dagegen schon.
proc = subprocess.Popen(["curl", curl_flags, url], stdout=subprocess.PIPE)
resp = proc.stdout

# Datei wird unter ihrem Originalnamen im aktuellen Verzeichnis gespeichert
dest = os.path.join(os.getcwd(), os.path.basename(filename) or "download.bin")
tmp  = dest + '.part'  # erst bei Erfolg umbenennen, damit Fehler keine bestehende Datei zerstören

def fail(msg):
    proc.kill()
    sys.exit(msg)

salt = resp.read(16)
if len(salt) != 16:
    fail("Download fehlgeschlagen oder ungültige Datei – Salt fehlt")

kdf = PBKDF2HMAC(algorithm=hashes.SHA256(), length=32, salt=salt,
                 iterations=100000)
key = kdf.derive(pw)
gcm = AESGCM(key)

def read_exactly(n):
    data = resp.read(n)
    if len(data) != n:
        raise EOFError("Unvollständiger Block")
    return data

try:
    with open(tmp, 'wb') as f:
        while True:
            hdr = resp.read(4)
            if not hdr: break
            if len(hdr) < 4: raise EOFError("Unvollständiger Block")
            block_len = struct.unpack('>I', hdr)[0]
            iv        = read_exactly(12)
            tag       = read_exactly(16)
            cipher    = read_exactly(block_len)
            f.write(gcm.decrypt(iv, cipher + tag, None))
    if proc.wait() != 0:
        raise EOFError(f"Download abgebrochen (curl Exit-Code {proc.returncode})")
    os.replace(tmp, dest)
except InvalidTag:
    os.remove(tmp)
    fail("Falsches Kennwort oder beschädigte Datei.")
except EOFError as e:
    os.remove(tmp)
    fail(f"Fehler: {e}")

print(f"Fertig: {dest}")
PYEOF
